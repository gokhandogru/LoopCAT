{
  "name": "loopcat",
  "version": "0.0.4-dev.20260831",
  "description": "The local-first translation workspace for professional editing, review, resources, and optional AI.",
  "homepage": "https://github.com/gokhandogru/LoopCAT",
  "private": true,
  "packageManager": "pnpm@11.0.7",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "desktop": "electron .",
    "build:renderer": "node scripts/build-renderer.cjs",
    "lint": "eslint src config desktop/runtime-settings.cjs scripts/build-renderer.cjs scripts/verify-renderer-build.cjs scripts/verify-electron-fuses.cjs scripts/verify-import-boundaries.cjs scripts/verify-accessibility.cjs tests/unit",
    "format:check": "prettier --check src config desktop/runtime-settings.cjs scripts/build-renderer.cjs scripts/verify-renderer-build.cjs scripts/verify-electron-fuses.cjs scripts/verify-import-boundaries.cjs scripts/verify-accessibility.cjs tests/component-gallery tests/unit",
    "format:write": "prettier --write src config desktop/runtime-settings.cjs scripts/build-renderer.cjs scripts/verify-renderer-build.cjs scripts/verify-electron-fuses.cjs scripts/verify-import-boundaries.cjs scripts/verify-accessibility.cjs tests/component-gallery tests/unit",
    "typecheck": "tsc --project tsconfig.json",
    "stylelint": "stylelint \"src/ui/**/*.css\" --allow-empty-input",
    "test:unit": "node --test \"tests/unit/**/*.test.cjs\"",
    "verify:imports": "node scripts/verify-import-boundaries.cjs",
    "verify:quality": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm stylelint && pnpm test:unit && pnpm verify:imports",
    "verify:a11y": "pnpm build:renderer && node scripts/verify-accessibility.cjs",
    "verify:visual": "pnpm verify:baseline",
    "verify:renderer": "node scripts/build-renderer.cjs && node scripts/verify-renderer-build.cjs",
    "verify:release": "node scripts/verify-release.cjs",
    "verify:baseline": "node scripts/capture-modernization-baseline.cjs --verify",
    "verify:bundle-contract": "node scripts/verify-bundle-contract.cjs",
    "verify:bundle-contract-selftest": "node scripts/verify-bundle-contract-selftest.cjs",
    "verify:xliff22-schema": "node scripts/verify-xliff22-schema.cjs",
    "verify:provenance": "node scripts/verify-release-provenance.cjs",
    "verify:provenance-selftest": "node scripts/verify-release-provenance-selftest.cjs",
    "verify:signing-env": "node scripts/verify-signing-env.cjs",
    "verify:signing-env-selftest": "node scripts/verify-signing-env-selftest.cjs",
    "verify:browser-runner": "node scripts/verify-browser-runner.cjs",
    "verify:ai-sidebar-ux": "node scripts/verify-ai-sidebar-ux.cjs",
    "verify:ollama-live": "node scripts/verify-live-ollama.cjs",
    "verify:ai-live": "node scripts/verify-live-ai-provider.cjs",
    "opuscat:web-bridge": "node scripts/opus-cat-web-bridge.cjs",
    "verify:desktop-wrapper": "node scripts/verify-desktop-wrapper.cjs",
    "verify:web-artifact": "node scripts/verify-web-artifact.cjs",
    "verify:web-smoke": "node scripts/verify-web-smoke.cjs",
    "verify:desktop-smoke": "node scripts/verify-packaged-desktop-smoke.cjs",
    "verify:fuses": "node scripts/verify-electron-fuses.cjs",
    "verify:artifact": "node scripts/verify-desktop-artifact.cjs",
    "verify:download-artifacts": "node scripts/verify-download-artifacts.cjs",
    "verify:download-artifacts-selftest": "node scripts/verify-download-artifacts-selftest.cjs",
    "verify:download-bundle": "node scripts/verify-download-artifacts.cjs --all",
    "verify:platform-signatures": "node scripts/verify-platform-signatures.cjs",
    "verify:platform-signatures-selftest": "node scripts/verify-platform-signatures-selftest.cjs",
    "verify:evidence": "node scripts/verify-release-evidence.cjs",
    "verify:evidence-selftest": "node scripts/verify-release-evidence-selftest.cjs",
    "i18n:extract": "node scripts/i18n-extract.cjs",
    "i18n:sync": "node scripts/i18n-sync.cjs",
    "i18n:validate": "node scripts/i18n-validate.cjs",
    "i18n:compile": "node scripts/i18n-compile.cjs",
    "checksums": "node scripts/generate-checksums.cjs",
    "verify:checksums": "node scripts/verify-checksums.cjs",
    "branding:icons": "electron scripts/generate-brand-icons.cjs",
    "downloads:prepare": "node scripts/publish-repository-downloads.cjs",
    "pack": "node scripts/build-desktop.cjs --dir",
    "dist:web": "node scripts/build-web.cjs",
    "dist:sites": "node scripts/build-sites.cjs",
    "dist:html": "node scripts/build-web.cjs",
    "dist": "node scripts/build-desktop.cjs",
    "dist:win": "node scripts/build-desktop.cjs --win nsis portable",
    "dist:mac": "node scripts/build-desktop.cjs --mac dmg zip",
    "dist:linux": "node scripts/build-desktop.cjs --linux AppImage deb",
    "verify:repository-downloads": "node scripts/verify-repository-downloads.cjs"
  },
  "keywords": [
    "cat-tool",
    "translation",
    "post-editing",
    "offline",
    "local-first"
  ],
  "author": {
    "name": "Dr. Gokhan Dogru",
    "email": "gokhandogru@users.noreply.github.com",
    "url": "https://www.linkedin.com/in/gokhan-dogru-localization/"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "axe-core": "4.13.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "globals": "17.4.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "org.loopcat.desktop",
    "productName": "LoopCAT",
    "asar": true,
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": {
      "app": ".cache/desktop-app",
      "output": "dist"
    },
    "files": [
      "build-info.json",
      "index.html",
      "styles.css",
      "liquid-glass/styles.css",
      "manifest.webmanifest",
      "service-worker.js",
      "icons/**",
      "app.js",
      "chunks/**",
      "cat-worker.js",
      "config/production-assets.js",
      "src/ui/tokens.css",
      "src/ui/themes.css",
      "src/ui/base.css",
      "src/ui/components.css",
      "src/ui/layouts.css",
      "desktop/**",
      "README.md",
      "LICENSE",
      "NOTICE",
      "docs/**",
      "!docs/loopcat-modern-software-review-*.md",
      "!docs/loopcat-modernization-plan-prompt-*.md"
    ],
    "win": {
      "icon": "icons/loopcat-icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "icons/loopcat-icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "icons/loopcat-icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Dr. Gokhan Dogru <gokhandogru@users.noreply.github.com>"
    }
  }
}
